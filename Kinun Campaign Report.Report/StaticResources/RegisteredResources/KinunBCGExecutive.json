{
  "name": "Kinun BCG Executive",
  "dataColors": [
    "#004D40",
    "#26A69A",
    "#D97706",
    "#64748B",
    "#DC2626",
    "#80CBC4",
    "#1E3A8A",
    "#A7F3D0"
  ],
  "background": "#FFFFFF",
  "foreground": "#111827",
  "tableAccent": "#004D40",
  "good": "#00796B",
  "neutral": "#D97706",
  "bad": "#DC2626",
  "maximum": "#004D40",
  "center": "#80CBC4",
  "minimum": "#F0F7F6",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#111827"
    },
    "title": {
      "fontSize": 13.5,
      "fontFace": "Segoe UI Semibold",
      "color": "#111827"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#111827"
    },
    "label": {
      "fontSize": 11,
      "fontFace": "Segoe UI",
      "color": "#334155"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 13.5,
            "fontColor": {
              "solid": {
                "color": "#111827"
              }
            },
            "alignment": "left",
            "titleWrap": true
          }
        ],
        "subTitle": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 10.5,
            "fontColor": {
              "solid": {
                "color": "#64748B"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#475569"
              }
            },
            "fontSize": 10.5,
            "gridlineShow": false,
            "showAxisTitle": false,
            "fontFamily": "Segoe UI"
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "fontSize": 10.5,
            "fontFamily": "Segoe UI",
            "gridlineColor": {
              "solid": {
                "color": "#EEF2F6"
              }
            },
            "gridlineStyle": "dotted",
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "fontSize": 11,
            "labelColor": {
              "solid": {
                "color": "#475569"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#334155"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F7F6"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E9EFEE"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#004D40"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9.5
          }
        ],
        "values": [
          {
            "fontSize": 9.5,
            "fontFamily": "Segoe UI"
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E5EBEA"
              }
            },
            "rowPadding": 5
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#004D40"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9.5
          }
        ],
        "rowHeaders": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 11.5
          }
        ],
        "values": [
          {
            "fontSize": 9.5,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#111827"
              }
            },
            "textSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#111827"
              }
            },
            "fontSize": 26,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "image": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}