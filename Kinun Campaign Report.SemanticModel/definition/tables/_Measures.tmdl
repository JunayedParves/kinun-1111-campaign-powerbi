/// Home table for all report measures, organized by display folder.
table _Measures
	lineageTag: 3a42c77f-360a-4688-b3aa-db1389acf7df

	/// Gross demand placed (Quantity x list price), all order statuses, before discounts.
	measure 'Gross Merchandise Value (GMV)' = SUM ( FactOrderLine[GrossLineAmountBDT] )
		formatString: ৳#,0
		displayFolder: 1. Sales
		lineageTag: fa23caf9-4812-43a8-8763-47a4f61dcdb5

	/// Gross line amount for Delivered orders only.
	measure 'Gross Sales Before Discounts' = CALCULATE ( SUM ( FactOrderLine[GrossLineAmountBDT] ), FactOrderLine[OrderStatus] = "Delivered" )
		formatString: ৳#,0
		displayFolder: 1. Sales
		lineageTag: 4d55f050-edad-4df6-ae7e-dab77589f4f0

	/// Item + allocated order-level discounts across all placed orders.
	measure 'Total Discount Amount' = SUM ( FactOrderLine[TotalLineDiscountBDT] )
		formatString: ৳#,0
		displayFolder: 1. Sales
		lineageTag: 5c18b1dc-1730-4330-80fc-a7d587207ac0

	/// Discounts on Delivered orders only.
	measure 'Realized Discount Amount' = CALCULATE ( SUM ( FactOrderLine[TotalLineDiscountBDT] ), FactOrderLine[OrderStatus] = "Delivered" )
		formatString: ৳#,0
		displayFolder: 1. Sales
		lineageTag: fc60b797-116d-46fd-bac2-267d996202db

	/// Total Discount Amount / GMV.
	measure 'Discount Rate %' = DIVIDE ( [Total Discount Amount], [Gross Merchandise Value (GMV)] )
		formatString: 0.0%
		displayFolder: 1. Sales
		lineageTag: c5bdae7b-16b5-4413-8577-dd28d8044852

	/// Realized revenue: net merchandise amount for Delivered orders, excluding shipping fee. Primary revenue measure.
	measure 'Net Merchandise Sales' = CALCULATE ( SUM ( FactOrderLine[NetMerchandiseAmountBDT] ), FactOrderLine[OrderStatus] = "Delivered" )
		formatString: ৳#,0
		displayFolder: 1. Sales
		lineageTag: 80731ebe-a079-4d48-adce-b84cde819236

	/// Units on Delivered orders.
	measure 'Units Sold' = CALCULATE ( SUM ( FactOrderLine[Quantity] ), FactOrderLine[OrderStatus] = "Delivered" )
		formatString: #,0
		displayFolder: 1. Sales
		lineageTag: 43d4d409-39b5-4cc9-85ce-75e927e7e902

	/// Net Merchandise Sales / Delivered Orders.
	measure 'Average Order Value (AOV)' = DIVIDE ( [Net Merchandise Sales], [Delivered Orders] )
		formatString: ৳#,0
		displayFolder: 1. Sales
		lineageTag: 8715caa1-c0ae-45d4-a7a0-5bfb41c0f863

	/// Cost of goods on Delivered orders.
	measure 'Total COGS' = CALCULATE ( SUM ( FactOrderLine[COGSAmountBDT] ), FactOrderLine[OrderStatus] = "Delivered" )
		formatString: ৳#,0
		displayFolder: 2. Profitability
		lineageTag: 110d26f0-bf0a-4c83-9feb-9c337d2ac9ea

	/// Gross margin on Delivered orders.
	measure 'Gross Margin' = CALCULATE ( SUM ( FactOrderLine[GrossMarginBDT] ), FactOrderLine[OrderStatus] = "Delivered" )
		formatString: ৳#,0
		displayFolder: 2. Profitability
		lineageTag: c225186c-951e-41ba-b441-dde7c915d833

	/// Gross Margin / Net Merchandise Sales.
	measure 'Gross Margin %' = DIVIDE ( [Gross Margin], [Net Merchandise Sales] )
		formatString: 0.0%
		displayFolder: 2. Profitability
		lineageTag: e0d83ec8-d680-4c77-8ccd-37793d61bdb9

	/// Net sales + shipping revenue - COGS - logistics - gateway fees, including negative RTO reverse-logistics cost.
	measure 'Contribution Margin' = SUM ( FactOrderLine[ContributionMarginBDT] )
		formatString: ৳#,0
		displayFolder: 2. Profitability
		lineageTag: 5c787185-6c53-423b-97a6-ac0a64ab3a20

	/// Contribution Margin / Net Merchandise Sales.
	measure 'Contribution Margin %' = DIVIDE ( [Contribution Margin], [Net Merchandise Sales] )
		formatString: 0.0%
		displayFolder: 2. Profitability
		lineageTag: 947a0637-4ea0-42ec-bddc-644ba4218c49

	/// Contribution Margin - Advertising Spend.
	measure 'Contribution Margin After Ad Spend' = [Contribution Margin] - [Advertising Spend]
		formatString: ৳#,0
		displayFolder: 2. Profitability
		lineageTag: d72200cd-67fc-4bde-8e06-4d1bf84dec5f

	/// Distinct orders across all statuses. Counted from FactOrderLine so it responds to product slicers.
	measure 'Total Orders' = DISTINCTCOUNT ( FactOrderLine[OrderID] )
		formatString: #,0
		displayFolder: 3. Orders & Customers
		lineageTag: 7859218c-2040-428c-bcd0-619e26762320

	measure 'Delivered Orders' = CALCULATE ( DISTINCTCOUNT ( FactOrderLine[OrderID] ), FactOrderLine[OrderStatus] = "Delivered" )
		formatString: #,0
		displayFolder: 3. Orders & Customers
		lineageTag: fda87061-9b1f-4547-8794-2fb5e113c00b

	measure 'Cancelled Orders' = CALCULATE ( DISTINCTCOUNT ( FactOrderLine[OrderID] ), FactOrderLine[OrderStatus] = "Cancelled" )
		formatString: #,0
		displayFolder: 3. Orders & Customers
		lineageTag: 4269909f-cbc8-43b6-852e-35e5a4ff6926

	measure 'Cancellation Rate %' = DIVIDE ( [Cancelled Orders], [Total Orders] )
		formatString: 0.0%
		displayFolder: 3. Orders & Customers
		lineageTag: 364fd7ec-a631-4aab-99cc-767849e1f89e

	/// Orders that failed at the doorstep and returned to origin.
	measure 'Doorstep RTO Orders' = CALCULATE ( DISTINCTCOUNT ( FactOrderLine[OrderID] ), FactOrderLine[OrderStatus] = "Delivery Failed (RTO)" )
		formatString: #,0
		displayFolder: 3. Orders & Customers
		lineageTag: d9e6a756-2d1e-4169-8324-4990094e4e57

	measure 'Doorstep RTO Rate %' = DIVIDE ( [Doorstep RTO Orders], [Total Orders] )
		formatString: 0.0%
		displayFolder: 3. Orders & Customers
		lineageTag: 4d661b8d-b07a-4af6-b849-abcb7523bb3e

	measure 'New Customer Orders' = CALCULATE ( DISTINCTCOUNT ( FactOrderHeader[OrderID] ), FactOrderHeader[IsNewCustomerOrder] = 1 )
		formatString: #,0
		displayFolder: 3. Orders & Customers
		lineageTag: ed5fb77d-483c-49b3-ad1b-07bff8c89a75

	measure 'Returning Customer Orders' = CALCULATE ( DISTINCTCOUNT ( FactOrderHeader[OrderID] ), FactOrderHeader[IsNewCustomerOrder] = 0 )
		formatString: #,0
		displayFolder: 3. Orders & Customers
		lineageTag: ab21a8d9-1df0-481a-9991-78647c6b6419

	measure 'New Customer Order Share %' = DIVIDE ( [New Customer Orders], [New Customer Orders] + [Returning Customer Orders] )
		formatString: 0.0%
		displayFolder: 3. Orders & Customers
		lineageTag: 2e3e92cd-2cd3-4ece-9ee0-4056be5c1395

	/// Distinct customers who placed at least one order in context.
	measure 'Active Customers' = DISTINCTCOUNT ( FactOrderHeader[CustomerKey] )
		formatString: #,0
		displayFolder: 3. Orders & Customers
		lineageTag: 2163d412-6ec7-41d1-9377-e082647f19b1

	/// Customers with more than one order in context.
	measure 'Repeat Customers' = COUNTROWS ( FILTER ( VALUES ( FactOrderHeader[CustomerKey] ), CALCULATE ( DISTINCTCOUNT ( FactOrderHeader[OrderID] ) ) > 1 ) )
		formatString: #,0
		displayFolder: 3. Orders & Customers
		lineageTag: 3203991d-5cd0-4bc3-aa0e-6ef8f412cad7

	measure 'Repeat Purchase Rate %' = DIVIDE ( [Repeat Customers], [Active Customers] )
		formatString: 0.0%
		displayFolder: 3. Orders & Customers
		lineageTag: 4c2d5fed-48c7-4c59-a6f4-d1d749b0610b

	/// LTV proxy: Net Merchandise Sales / Active Customers.
	measure 'Net Sales per Customer' = DIVIDE ( [Net Merchandise Sales], [Active Customers] )
		formatString: ৳#,0
		displayFolder: 3. Orders & Customers
		lineageTag: 4354bf95-8242-4351-adff-0003906cdf57

	measure Impressions = SUM ( FactMarketingDaily[Impressions] )
		formatString: #,0
		displayFolder: 4. Marketing Funnel
		lineageTag: 076f9a02-51d6-4b24-b03f-f99b127687d5

	measure Clicks = SUM ( FactMarketingDaily[Clicks] )
		formatString: #,0
		displayFolder: 4. Marketing Funnel
		lineageTag: 1947595b-6269-492e-be5a-f05febd608cb

	measure Sessions = SUM ( FactMarketingDaily[Sessions] )
		formatString: #,0
		displayFolder: 4. Marketing Funnel
		lineageTag: c5d41b00-7bc2-4b15-b796-33d61e70247b

	measure 'Product Views' = SUM ( FactMarketingDaily[ProductDetailViews] )
		formatString: #,0
		displayFolder: 4. Marketing Funnel
		lineageTag: 6ef7bfc6-05b6-48f6-8efe-451199711f6b

	measure 'Add-to-Cart Events' = SUM ( FactMarketingDaily[AddToCartEvents] )
		formatString: #,0
		displayFolder: 4. Marketing Funnel
		lineageTag: 893d1eff-e5a4-4fb8-b8ef-a99982564e2c

	measure 'Checkout Starts' = SUM ( FactMarketingDaily[CheckoutStarts] )
		formatString: #,0
		displayFolder: 4. Marketing Funnel
		lineageTag: 98291a85-7f55-4a69-80c1-9d3990d3098c

	/// 7-day last non-direct click attributed orders. Do not mix with transactional order counts.
	measure 'Attributed Orders' = SUM ( FactMarketingDaily[AttributedOrders] )
		formatString: #,0
		displayFolder: 4. Marketing Funnel
		lineageTag: 694108d8-0da4-4cc8-a38f-7c8473348f78

	/// 7-day last non-direct click attributed revenue. Do not mix with Net Merchandise Sales.
	measure 'Attributed Net Revenue' = SUM ( FactMarketingDaily[AttributedNetRevenueBDT] )
		formatString: ৳#,0
		displayFolder: 4. Marketing Funnel
		lineageTag: 728cae5c-6835-433c-9d05-fe53522b4613

	measure 'Click-Through Rate %' = DIVIDE ( [Clicks], [Impressions] )
		formatString: 0.00%
		displayFolder: 4. Marketing Funnel
		lineageTag: 3202d2fd-1a1b-4eb7-b4b1-339ce3d41f51

	measure 'Add-to-Cart Rate %' = DIVIDE ( [Add-to-Cart Events], [Sessions] )
		formatString: 0.0%
		displayFolder: 4. Marketing Funnel
		lineageTag: 3db60ebc-2064-4ac4-9c02-5bcfcbcf87ce

	measure 'Cart-to-Checkout Rate %' = DIVIDE ( [Checkout Starts], [Add-to-Cart Events] )
		formatString: 0.0%
		displayFolder: 4. Marketing Funnel
		lineageTag: d2402b19-70da-4400-9dc5-85284723aafa

	measure 'Checkout Completion Rate %' = DIVIDE ( [Attributed Orders], [Checkout Starts] )
		formatString: 0.0%
		displayFolder: 4. Marketing Funnel
		lineageTag: 495587cc-e4bd-44aa-afb5-df59f2232b31

	measure 'Session Conversion Rate %' = DIVIDE ( [Attributed Orders], [Sessions] )
		formatString: 0.00%
		displayFolder: 4. Marketing Funnel
		lineageTag: a17fb052-23ac-4c42-911d-a40af85ab237

	measure 'Advertising Spend' = SUM ( FactMarketingDaily[AdSpendBDT] )
		formatString: ৳#,0
		displayFolder: 4. Marketing Funnel
		lineageTag: f8e151c8-eec3-401f-a66f-7a838ccae4d7

	/// Attributed Net Revenue / Advertising Spend.
	measure ROAS = DIVIDE ( [Attributed Net Revenue], [Advertising Spend] )
		formatString: 0.00"x"
		displayFolder: 4. Marketing Funnel
		lineageTag: aa26e395-685a-4cdb-80ce-33e26fe63079

	/// Transactional Net Merchandise Sales / Advertising Spend.
	measure 'Marketing Efficiency Ratio (MER)' = DIVIDE ( [Net Merchandise Sales], [Advertising Spend] )
		formatString: 0.00"x"
		displayFolder: 4. Marketing Funnel
		lineageTag: f8d08de2-084f-45fb-a20f-0f154f2cc1df

	/// Advertising Spend / New Customer Orders.
	measure 'Customer Acquisition Cost (CAC)' = DIVIDE ( [Advertising Spend], [New Customer Orders] )
		formatString: ৳#,0
		displayFolder: 4. Marketing Funnel
		lineageTag: d74fcf09-58f7-4171-84dc-55846e54470f

	/// GMV in the 11.11 Main Event Window.
	measure 'Campaign GMV' = CALCULATE ( [Gross Merchandise Value (GMV)], DimCampaign[EventClassification] = "11.11 Main Event Window" )
		formatString: ৳#,0
		displayFolder: 5. 11.11 Campaign
		lineageTag: ab71ae36-2d5b-463c-88e0-6e8959a5f825

	measure 'Campaign Net Sales' = CALCULATE ( [Net Merchandise Sales], DimCampaign[EventClassification] = "11.11 Main Event Window" )
		formatString: ৳#,0
		displayFolder: 5. 11.11 Campaign
		lineageTag: c68daf40-667b-46ab-bfa1-f581e6a5a5a6

	measure 'Campaign Orders' = CALCULATE ( [Total Orders], DimCampaign[EventClassification] = "11.11 Main Event Window" )
		formatString: #,0
		displayFolder: 5. 11.11 Campaign
		lineageTag: 99cb4987-a6c4-4d87-b15d-2dbe6e62477d

	measure 'Campaign Delivered Orders' = CALCULATE ( [Delivered Orders], DimCampaign[EventClassification] = "11.11 Main Event Window" )
		formatString: #,0
		displayFolder: 5. 11.11 Campaign
		lineageTag: 0cbe936a-5f20-422f-8618-b487044d9a88

	measure 'Campaign AOV' = DIVIDE ( [Campaign Net Sales], [Campaign Delivered Orders] )
		formatString: ৳#,0
		displayFolder: 5. 11.11 Campaign
		lineageTag: eae084ae-ce2f-4655-bcc1-f336bf6eae16

	measure 'Campaign Discount Rate %' = CALCULATE ( [Discount Rate %], DimCampaign[EventClassification] = "11.11 Main Event Window" )
		formatString: 0.0%
		displayFolder: 5. 11.11 Campaign
		lineageTag: 020dca40-2da0-4b6c-9d58-8e2b5b1b3fe2

	/// Average daily Net Merchandise Sales over the pre-event normal trading baseline (DimDate[IsPreEventBaselineWindow] = 1).
	measure 'Baseline Daily Net Sales' = CALCULATE ( DIVIDE ( [Net Merchandise Sales], DISTINCTCOUNT ( DimDate[DateKey] ) ), REMOVEFILTERS ( DimCampaign ), REMOVEFILTERS ( DimDate[SeasonalEventType] ), REMOVEFILTERS ( DimDate[Is1111EventWindow] ), DimDate[IsPreEventBaselineWindow] = 1 )
		formatString: ৳#,0
		displayFolder: 5. 11.11 Campaign
		lineageTag: 666a0ed0-522e-42d9-a169-df80d70e748d

	/// Campaign Net Sales / (2.25 days x number of 11.11 events in context). The 54-hour window = 2.25 24-hour days; dividing by event count keeps multi-year totals comparable to the baseline.
	measure '11.11 Equivalent Daily Net Sales' =
			VAR _Events =
			    COUNTROWS (
			        FILTER (
			            VALUES ( DimDate[Year] ),
			            NOT ISBLANK ( [Campaign Net Sales] )
			        )
			    )
			RETURN
			    DIVIDE ( [Campaign Net Sales], 2.25 * _Events )
		formatString: ৳#,0
		displayFolder: 5. 11.11 Campaign
		lineageTag: 2d240eed-7ed1-4432-ac82-69c3840523f3

	/// Descriptive comparison of 11.11 daily run-rate vs pre-event baseline. Not a causal estimate.
	measure 'Campaign Lift vs Baseline %' = DIVIDE ( [11.11 Equivalent Daily Net Sales] - [Baseline Daily Net Sales], [Baseline Daily Net Sales] )
		formatString: 0.0%
		displayFolder: 5. 11.11 Campaign
		lineageTag: 944bc966-841b-4dd2-8894-ff96e3616db4

	/// Average daily Net Merchandise Sales across trading days in the 11.11 Post-Event Window.
	measure 'Post-Campaign Daily Net Sales' =
			CALCULATE (
			    DIVIDE (
			        [Net Merchandise Sales],
			        DISTINCTCOUNT ( FactOrderLine[OrderDateKey] )
			    ),
			    REMOVEFILTERS ( DimCampaign ),
			    DimCampaign[EventClassification] = "11.11 Post-Event Window"
			)
		formatString: ৳#,0
		displayFolder: 5. 11.11 Campaign
		lineageTag: 39d7d12a-9672-4fc3-ba3a-ca013da87bf4

	measure 'Post-Campaign Retention vs Baseline %' = DIVIDE ( [Post-Campaign Daily Net Sales] - [Baseline Daily Net Sales], [Baseline Daily Net Sales] )
		formatString: 0.0%
		displayFolder: 5. 11.11 Campaign
		lineageTag: dd838b24-d475-4141-9fa2-633334844bd1

	/// Sessions from FactHourlyCampaignTraffic (event and comparator windows only). Use with HourOfDayBDT.
	measure 'Hourly Sessions' = SUM ( FactHourlyCampaignTraffic[Sessions] )
		formatString: #,0
		displayFolder: 5. 11.11 Campaign
		lineageTag: b2485b67-5c0a-4f0b-8a22-bb7b4f3632c0

	measure 'Hourly Orders' = SUM ( FactHourlyCampaignTraffic[Orders] )
		formatString: #,0
		displayFolder: 5. 11.11 Campaign
		lineageTag: 2f280a68-1f97-4cf1-9b1a-7cded5d620f2

	measure 'Hourly Net Sales' = SUM ( FactHourlyCampaignTraffic[NetMerchandiseSalesBDT] )
		formatString: ৳#,0
		displayFolder: 5. 11.11 Campaign
		lineageTag: 009ec3c6-a7c3-4f67-b79c-4a85a9889d8a

	measure 'Hourly Conversion Rate %' = DIVIDE ( [Hourly Orders], [Hourly Sessions] )
		formatString: 0.00%
		displayFolder: 5. 11.11 Campaign
		lineageTag: 4598b8e1-5fef-4e82-a0c3-e00dd8cef83b

	measure 'Total Payment Attempts' = COUNTROWS ( FactPayment )
		formatString: #,0
		displayFolder: 6. Payments
		lineageTag: f3335da8-5c72-477c-bdc0-c187c5f9224d

	measure 'Failed Payment Attempts' = CALCULATE ( COUNTROWS ( FactPayment ), FactPayment[PaymentStatus] IN { "Failed", "Failed (COD Refused at Doorstep)" } )
		formatString: #,0
		displayFolder: 6. Payments
		lineageTag: fff4c8b6-5946-4a3e-820e-a30ec26b953f

	measure 'Payment Failure Rate %' = DIVIDE ( [Failed Payment Attempts], [Total Payment Attempts] )
		formatString: 0.0%
		displayFolder: 6. Payments
		lineageTag: e131c548-dd34-44f4-b1eb-bd3f36bfc8ff

	/// Attempts with status Captured or Collected (COD).
	measure 'Successful Payment Attempts' = CALCULATE ( COUNTROWS ( FactPayment ), FactPayment[PaymentStatus] IN { "Captured", "Collected (COD)" } )
		formatString: #,0
		displayFolder: 6. Payments
		lineageTag: 823258ef-afcb-4f1a-a919-70e07c3efb89

	/// Cash actually collected (by order date). Never sum AttemptedAmountBDT as revenue.
	measure 'Successful Collection Amount' = SUM ( FactPayment[CollectedAmountBDT] )
		formatString: ৳#,0
		displayFolder: 6. Payments
		lineageTag: bafbe682-c08f-4cc2-b6e1-1299eb3d42d0

	/// Collected amount on the payment date via the inactive PaymentDateKey relationship.
	measure 'Collection by Settlement Date' = CALCULATE ( SUM ( FactPayment[CollectedAmountBDT] ), USERELATIONSHIP ( FactPayment[PaymentDateKey], DimDate[DateKey] ) )
		formatString: ৳#,0
		displayFolder: 6. Payments
		lineageTag: aba63682-67d7-48a2-866b-29c4ece94ef3

	measure 'Gateway Transaction Fees' = SUM ( FactPayment[TransactionFeeBDT] )
		formatString: ৳#,0
		displayFolder: 6. Payments
		lineageTag: 9a8da003-7cd3-4ebf-854e-6b9359298044

	measure 'Total Shipments' = COUNTROWS ( FactDelivery )
		formatString: #,0
		displayFolder: 7. Delivery
		lineageTag: 99d4c94e-df0c-40e2-95c8-b122dbcd2310

	measure 'Delivered Shipments' = CALCULATE ( COUNTROWS ( FactDelivery ), FactDelivery[DeliveryStatus] = "Delivered" )
		formatString: #,0
		displayFolder: 7. Delivery
		lineageTag: 2654656b-5493-47ed-9556-7815facdf35b

	measure 'Delivery Success Rate %' = DIVIDE ( [Delivered Shipments], [Total Shipments] )
		formatString: 0.0%
		displayFolder: 7. Delivery
		lineageTag: 1aea727c-2b97-4276-84ed-a1ac48b5628a

	measure 'On-Time Deliveries' = CALCULATE ( COUNTROWS ( FactDelivery ), FactDelivery[DeliveryStatus] = "Delivered", FactDelivery[IsOnTimeDelivery] = 1 )
		formatString: #,0
		displayFolder: 7. Delivery
		lineageTag: 29cef699-6836-481c-bebf-6bf94ffe91ab

	/// On-time deliveries / delivered shipments.
	measure 'On-Time Delivery Rate %' = DIVIDE ( [On-Time Deliveries], [Delivered Shipments] )
		formatString: 0.0%
		displayFolder: 7. Delivery
		lineageTag: 6ce3ed31-a804-4f66-8d94-312a926f7e3d

	measure 'Avg Delivery Lead Time (Days)' = CALCULATE ( AVERAGE ( FactDelivery[DeliveryLeadTimeDays] ), FactDelivery[DeliveryStatus] = "Delivered" )
		formatString: 0.0
		displayFolder: 7. Delivery
		lineageTag: 545fb0ba-5ad5-475b-921f-8356371b1bbb

	measure 'Shipping Cost' = SUM ( FactDelivery[ShippingCostBDT] )
		formatString: ৳#,0
		displayFolder: 7. Delivery
		lineageTag: 4ba52b2d-cc1e-479c-b6dd-7221b92ad711

	/// Shipment count on dispatch date via the inactive DispatchDateKey relationship.
	measure 'Shipments by Dispatch Date' = CALCULATE ( COUNTROWS ( FactDelivery ), USERELATIONSHIP ( FactDelivery[DispatchDateKey], DimDate[DateKey] ) )
		formatString: #,0
		displayFolder: 7. Delivery
		lineageTag: 36fc22c1-37c9-4e04-9099-ca7f36ddd0a5

	measure 'Returned Units' = SUM ( FactReturn[ReturnQuantity] )
		formatString: #,0
		displayFolder: 8. Returns
		lineageTag: d1cbb2c4-1415-439d-9e97-f5a370682662

	measure 'Return Rate (Units) %' = DIVIDE ( [Returned Units], [Units Sold] )
		formatString: 0.0%
		displayFolder: 8. Returns
		lineageTag: 0b2f3940-b399-41cc-9290-bf636177596a

	measure 'Refund Amount' = SUM ( FactReturn[RefundAmountBDT] )
		formatString: ৳#,0
		displayFolder: 8. Returns
		lineageTag: d26fb825-5980-4224-b8bb-45e354a0d368

	measure 'Return Rate (Value) %' = DIVIDE ( [Refund Amount], [Net Merchandise Sales] )
		formatString: 0.0%
		displayFolder: 8. Returns
		lineageTag: e930968a-8e62-4707-bf22-b087dfee8410

	measure 'Return Handling Cost' = SUM ( FactReturn[ReturnHandlingCostBDT] )
		formatString: ৳#,0
		displayFolder: 8. Returns
		lineageTag: eb8ffecd-3f20-4ddd-9677-e375890d1766

	measure 'Restockable Return %' = DIVIDE ( CALCULATE ( SUM ( FactReturn[ReturnQuantity] ), FactReturn[IsRestockable] = 1 ), [Returned Units] )
		formatString: 0.0%
		displayFolder: 8. Returns
		lineageTag: 0beb8b08-c5ed-4555-8a3e-3300de5ebf71

	/// Refund amount on the return-processing date via the inactive ReturnDateKey relationship.
	measure 'Refunds by Return Date' = CALCULATE ( [Refund Amount], USERELATIONSHIP ( FactReturn[ReturnDateKey], DimDate[DateKey] ) )
		formatString: ৳#,0
		displayFolder: 8. Returns
		lineageTag: d24deccb-19e0-4b18-be93-fa1ad177e20d

	/// Semi-additive: closing stock at the last snapshot date in context.
	measure 'Ending Inventory Units' = LASTNONBLANKVALUE ( DimDate[FullDate], SUM ( FactInventoryWeekly[ClosingStockUnits] ) )
		formatString: #,0
		displayFolder: 9. Inventory
		lineageTag: b9835959-50ce-4165-8b73-3fc76a9ff1db

