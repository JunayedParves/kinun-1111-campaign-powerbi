	/// Net sales gap if 11.11-acquired customers were worth as much per head as normally acquired customers.
	measure 'Upside Cohort Value Gap' =
			VAR _N = CALCULATE ( [Active Customers], DimCustomer[AcquiredDuring1111Flag] = 1, REMOVEFILTERS ( DimDate ) )
			VAR _Gap = CALCULATE ( [Net Sales per Customer], DimCustomer[AcquiredDuring1111Flag] = 0, REMOVEFILTERS ( DimDate ) ) - CALCULATE ( [Net Sales per Customer], DimCustomer[AcquiredDuring1111Flag] = 1, REMOVEFILTERS ( DimDate ) )
			RETURN MAX ( 0, _N * _Gap )
		formatString: ৳#,0
		displayFolder: 12. Strategic Priorities
		lineageTag: 55578819-6cba-45d4-96f6-6671fa7f25ac

	column MeasureTable
		isHidden
		lineageTag: d95c2401-e093-471b-aad2-881fb6384f7e
		isNameInferred
		sourceColumn: [MeasureTable]

	partition _Measures = calculated
		mode: import
		source = ROW("MeasureTable", BLANK())

