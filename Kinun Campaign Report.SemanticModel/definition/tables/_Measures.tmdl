	/// YoY growth when one year is in context; compound annual growth across the first and last selected year otherwise.
	measure 'Net Sales Growth %' =
			VAR _MinY = CALCULATE ( MIN ( DimDate[Year] ), FILTER ( VALUES ( DimDate[Year] ), NOT ISBLANK ( [Net Merchandise Sales] ) ) )
			VAR _MaxY = CALCULATE ( MAX ( DimDate[Year] ), FILTER ( VALUES ( DimDate[Year] ), NOT ISBLANK ( [Net Merchandise Sales] ) ) )
			VAR _First = CALCULATE ( [Net Merchandise Sales], DimDate[Year] = _MinY )
			VAR _Last = CALCULATE ( [Net Merchandise Sales], DimDate[Year] = _MaxY )
			RETURN
			    IF (
			        _MinY = _MaxY,
			        [YoY Net Sales Growth %],
			        IF ( _First > 0, POWER ( DIVIDE ( _Last, _First ), DIVIDE ( 1, _MaxY - _MinY ) ) - 1 )
			    )
		formatString: 0.0%
		displayFolder: 10. Time Intelligence
		lineageTag: 6c48a855-4a64-4d81-aae3-6a9ab6719955

	measure 'KPI Net Sales Subtitle' =
			VAR _MinY = CALCULATE ( MIN ( DimDate[Year] ), FILTER ( VALUES ( DimDate[Year] ), NOT ISBLANK ( [Net Merchandise Sales] ) ) )
			VAR _MaxY = CALCULATE ( MAX ( DimDate[Year] ), FILTER ( VALUES ( DimDate[Year] ), NOT ISBLANK ( [Net Merchandise Sales] ) ) )
			VAR _G = [Net Sales Growth %]
			RETURN
			    IF (
			        ISBLANK ( _G ),
			        "First year in range – no comparison",
			        IF ( _G >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _G ), "0.0%" )
			            & IF ( _MinY = _MaxY, " vs prior year", " CAGR " & _MinY & "–" & RIGHT ( _MaxY, 2 ) )
			    )
		displayFolder: 11. Dashboard Text
		lineageTag: 6e9459b5-c55e-432c-924b-168fe4270e4b

	measure 'KPI Net Sales Color' = IF ( [Net Sales Growth %] < 0, "#DC2626", "#00796B" )
