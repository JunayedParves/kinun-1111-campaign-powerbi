	measure 'Title Category Campaign' =
			VAR _C = FILTER ( ADDCOLUMNS ( VALUES ( DimProduct[Category] ), "@n", [Campaign Net Sales], "@m", [Campaign Contribution Margin %] ), NOT ISBLANK ( [@n] ) )
			VAR _Top = TOPN ( 1, _C, [@n], DESC )
			VAR _Best = TOPN ( 1, _C, [@m], DESC )
			RETURN
			    IF (
			        ISEMPTY ( _C ),
			        "11.11 discount depth vs margin by category",
			        "In 11.11, " & MAXX ( _Top, DimProduct[Category] ) & " (" & FORMAT ( DIVIDE ( MAXX ( _Top, [@n] ), [Campaign Net Sales] ), "0%" ) & " of event sales) run at "
			            & FORMAT ( MAXX ( _Top, [@m] ), "0.0%" ) & " margin; " & MAXX ( _Best, DimProduct[Category] ) & " hold " & FORMAT ( MAXX ( _Best, [@m] ), "0.0%" )
			    )
		displayFolder: 11. Dashboard Text
