	measure 'KPI CM Subtitle' =
			VAR _P = [Contribution Margin %]
			RETURN
			    FORMAT ( _P, "0.0%" ) & " of net sales · "
			        & SWITCH ( TRUE (), _P >= 0.10, "healthy", _P >= 0.03, "under pressure", "margin trap" )
		displayFolder: 11. Dashboard Text
		lineageTag: 2cb7d32a-39b2-4715-972a-556263bfda0c

	measure 'KPI CM Color' =
			VAR _P = [Contribution Margin %]
			RETURN SWITCH ( TRUE (), _P >= 0.10, "#00796B", _P >= 0.03, "#D97706", "#DC2626" )
		displayFolder: 11. Dashboard Text
