	measure 'KPI Campaign CM Subtitle' = IF ( ISBLANK ( [Campaign Net Sales] ), "No 11.11 sales in selection", "vs " & FORMAT ( [Normal Trading Contribution Margin %], "0.0%" ) & " in normal trading" )
		displayFolder: 11. Dashboard Text
