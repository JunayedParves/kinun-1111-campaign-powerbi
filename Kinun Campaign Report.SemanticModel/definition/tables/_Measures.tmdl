	measure 'Selection Context' =
			VAR _Y = IF ( ISFILTERED ( DimDate[Year] ), CONCATENATEX ( VALUES ( DimDate[Year] ), DimDate[Year], ", ", DimDate[Year], ASC ), "2022–2025" )
			VAR _E = IF ( ISFILTERED ( DimCampaign[EventClassification] ), CONCATENATEX ( VALUES ( DimCampaign[EventClassification] ), DimCampaign[EventClassification], ", " ), "All event windows" )
			VAR _D = IF ( ISFILTERED ( DimGeography[Division] ), CONCATENATEX ( VALUES ( DimGeography[Division] ), DimGeography[Division], ", " ), "All divisions" )
			VAR _C = IF ( ISFILTERED ( DimProduct[Category] ), CONCATENATEX ( VALUES ( DimProduct[Category] ), DimProduct[Category], ", " ), "All categories" )
			RETURN "Showing: " & _Y & "  |  " & _E & "  |  " & _D & "  |  " & _C & "  |  Amounts in BDT (৳) · Synthetic portfolio data"
		displayFolder: 11. Dashboard Text
		lineageTag: 57e160ea-70d6-4881-b31c-5fcb7e981234

	measure 'Headline Executive' =
			VAR _NS = [Net Merchandise Sales]
			VAR _G = [Net Sales Growth %]
			VAR _L = [Campaign Daily Lift Multiple]
			VAR _One = HASONEVALUE ( DimDate[Year] )
			VAR _NSTxt = "৳" & IF ( ABS ( _NS ) >= 1e9, FORMAT ( _NS / 1e9, "0.00" ) & "B", FORMAT ( _NS / 1e6, "0.0" ) & "M" )
			RETURN
			    "Net sales of " & _NSTxt
			        & IF ( NOT ISBLANK ( _G ), " (" & FORMAT ( _G, "+0.0%;-0.0%" ) & IF ( _One, " YoY", " CAGR" ) & ")" )
			        & IF (
			            NOT ISBLANK ( _L ),
			            " – 11.11 multiplies daily sales " & FORMAT ( _L, "0.0" ) & "x, but earns only "
			                & FORMAT ( [Campaign Contribution Margin %], "0.0%" ) & " contribution margin vs "
			                & FORMAT ( [Normal Trading Contribution Margin %], "0.0%" ) & " in normal trading",
			            " – contribution margin " & FORMAT ( [Contribution Margin %], "0.0%" )
			        )
		displayFolder: 11. Dashboard Text
		lineageTag: c37f1b77-57a8-429d-90cd-54c48d0cc8a5

	measure 'Headline Campaign' =
			IF (
			    ISBLANK ( [Campaign Net Sales] ),
			    "No 11.11 Main Event sales in the current selection – reset the Event Window filter to compare",
			    "The 54-hour 11.11 window runs at " & FORMAT ( [Campaign Daily Lift Multiple], "0.0" ) & "x baseline daily sales, but "
			        & FORMAT ( [Campaign Discount Rate %], "0.0%" ) & " discounting and " & FORMAT ( [Campaign Payment Failure Rate %], "0.0%" )
			        & " payment failures squeeze contribution margin to " & FORMAT ( [Campaign Contribution Margin %], "0.0%" )
			)
		displayFolder: 11. Dashboard Text
		lineageTag: 68803ee6-104f-45c5-8110-9a103b9cc0c4

	measure 'Headline Marketing' =
			VAR _T = FILTER ( ADDCOLUMNS ( VALUES ( DimChannel[ChannelName] ), "@r", [ROAS] ), [@r] > 0 )
			VAR _B = TOPN ( 1, _T, [@r], DESC )
			VAR _W = TOPN ( 1, _T, [@r], ASC )
			RETURN
			    IF (
			        ISEMPTY ( _T ),
			        "No paid media in the current selection",
			        MAXX ( _B, DimChannel[ChannelName] ) & " returns " & FORMAT ( MAXX ( _B, [@r] ), "0" ) & "x on ad spend vs "
			            & FORMAT ( MAXX ( _W, [@r] ), "0" ) & "x for " & MAXX ( _W, DimChannel[ChannelName] )
			            & " – zero-media channels already deliver " & FORMAT ( [Zero-Media Channel Share %], "0%" ) & " of net sales"
			    )
		displayFolder: 11. Dashboard Text
		lineageTag: c50d5e92-b11c-4f7a-8b17-f79629952cbf

	measure 'Headline Product' =
			VAR _C = FILTER ( ADDCOLUMNS ( VALUES ( DimProduct[Category] ), "@s", [Net Merchandise Sales], "@m", [Contribution Margin %] ), NOT ISBLANK ( [@s] ) )
			VAR _Top = TOPN ( 1, _C, [@s], DESC )
			VAR _Share = DIVIDE ( MAXX ( _Top, [@s] ), [Net Merchandise Sales] )
			VAR _MT = [Margin-Trap Campaign CM %]
			RETURN
			    MAXX ( _Top, DimProduct[Category] ) & " drive " & FORMAT ( _Share, "0%" ) & " of net sales at " & FORMAT ( MAXX ( _Top, [@m] ), "0.0%" ) & " margin"
			        & IF (
			            NOT ISBLANK ( _MT ),
			            "; " & [Margin-Trap SKU Count] & " margin-trap SKUs swing to " & FORMAT ( _MT, "0.0%" ) & " during 11.11 at "
			                & FORMAT ( [Margin-Trap Campaign Discount %], "0.0%" ) & " discount"
			        )
		displayFolder: 11. Dashboard Text
		lineageTag: 5b45c5cd-60f1-4c4f-8220-66c3584c78ee

	measure 'Headline Operations' =
			VAR _DF = CALCULATE ( [Payment Failure Rate %], DimCampaign[EventClassification] = "11.11 Main Event Window", DimPaymentMethod[CODDigitalClass] = "Digital Prepayment" )
			VAR _DN = CALCULATE ( [Payment Failure Rate %], DimCampaign[EventClassification] = "Normal Trading", DimPaymentMethod[CODDigitalClass] = "Digital Prepayment" )
			VAR _Z = TOPN ( 1, FILTER ( ADDCOLUMNS ( VALUES ( DimGeography[DeliveryZone] ), "@o", [On-Time Delivery Rate %] ), NOT ISBLANK ( [@o] ) ), [@o], ASC )
			RETURN
			    IF ( NOT ISBLANK ( _DF ), "Digital payment failures jump from " & FORMAT ( _DN, "0.0%" ) & " to " & FORMAT ( _DF, "0.0%" ) & " during 11.11; ", "" )
			        & MAXX ( _Z, DimGeography[DeliveryZone] ) & " on-time delivery lags at " & FORMAT ( MAXX ( _Z, [@o] ), "0%" )
			        & ", and 11.11-acquired customers repeat less (" & FORMAT ( [11.11-Acquired Repeat Rate %], "0%" ) & " vs " & FORMAT ( [Normal-Acquired Repeat Rate %], "0%" ) & ")"
		displayFolder: 11. Dashboard Text
		lineageTag: 988bd5b1-419d-4e41-9805-77a72d41a236

	measure 'Title Monthly Trend' =
			VAR _T = FILTER ( ADDCOLUMNS ( VALUES ( DimDate[YearMonth] ), "@s", [Net Merchandise Sales], "@m", [Contribution Margin %] ), NOT ISBLANK ( [@s] ) )
			VAR _Pk = TOPN ( 1, _T, [@s], DESC )
			VAR _Lo = TOPN ( 1, _T, [@m], ASC )
			VAR _V = MAXX ( _Pk, [@s] )
			RETURN
			    "Sales peak in " & MAXX ( _Pk, DimDate[YearMonth] ) & " (৳" & FORMAT ( _V / 1e6, "0" ) & "M) while margin bottoms at "
			        & FORMAT ( MAXX ( _Lo, [@m] ), "0.0%" ) & " in " & MAXX ( _Lo, DimDate[YearMonth] ) & " – event months buy volume with margin"
		displayFolder: 11. Dashboard Text
		lineageTag: c50612df-4aa3-4dae-9b0c-c3ccb09fad6a

	measure 'Title Category Mix' =
			VAR _C = FILTER ( ADDCOLUMNS ( VALUES ( DimProduct[Category] ), "@s", [Net Merchandise Sales], "@m", [Contribution Margin %] ), NOT ISBLANK ( [@s] ) )
			VAR _Top = TOPN ( 1, _C, [@s], DESC )
			VAR _Best = TOPN ( 1, _C, [@m], DESC )
			RETURN
			    MAXX ( _Top, DimProduct[Category] ) & " carry " & FORMAT ( DIVIDE ( MAXX ( _Top, [@s] ), [Net Merchandise Sales] ), "0%" ) & " of sales at "
			        & FORMAT ( MAXX ( _Top, [@m] ), "0.0%" ) & " margin; " & MAXX ( _Best, DimProduct[Category] ) & " earn " & FORMAT ( MAXX ( _Best, [@m] ), "0.0%" )
		displayFolder: 11. Dashboard Text
		lineageTag: 1ff77775-83e5-42fc-b57a-47cb4cf4a15f

	measure 'Title Event Windows' =
			VAR _E = FILTER ( ADDCOLUMNS ( VALUES ( DimCampaign[EventClassification] ), "@m", [Contribution Margin %] ), NOT ISBLANK ( [@m] ) )
			VAR _Lo = TOPN ( 1, _E, [@m], ASC )
			RETURN
			    MAXX ( _Lo, DimCampaign[EventClassification] ) & " is the least profitable window at " & FORMAT ( MAXX ( _Lo, [@m] ), "0.0%" )
			        & " contribution margin vs " & FORMAT ( [Normal Trading Contribution Margin %], "0.0%" ) & " in normal trading"
		displayFolder: 11. Dashboard Text
		lineageTag: 9da6d8c3-773d-44db-8510-7f9baf1afb19

	measure 'Title Lift by Year' =
			VAR _Y = FILTER ( ADDCOLUMNS ( VALUES ( DimDate[Year] ), "@l", [Campaign Daily Lift Multiple], "@n", [Campaign Net Sales] ), NOT ISBLANK ( [@n] ) )
			VAR _MinY = MINX ( _Y, DimDate[Year] )
			VAR _MaxY = MAXX ( _Y, DimDate[Year] )
			RETURN
			    IF (
			        _MinY = _MaxY,
			        "11.11 " & _MaxY & " ran at " & FORMAT ( MAXX ( _Y, [@l] ), "0.0" ) & "x baseline daily sales",
			        "11.11 lift grew from " & FORMAT ( MAXX ( FILTER ( _Y, DimDate[Year] = _MinY ), [@l] ), "0.0" ) & "x to "
			            & FORMAT ( MAXX ( FILTER ( _Y, DimDate[Year] = _MaxY ), [@l] ), "0.0" ) & "x baseline (" & _MinY & "–" & _MaxY & ") – the event is scaling, not saturating"
			    )
		displayFolder: 11. Dashboard Text
		lineageTag: 21caf822-7c65-4f21-b23a-e4cd186d763a

	measure 'Title Hourly Curve' =
			VAR _Win = FILTER ( ALL ( FactHourlyCampaignTraffic[Hours Since Launch] ), NOT ISBLANK ( FactHourlyCampaignTraffic[Hours Since Launch] ) )
			VAR _All = CALCULATE ( [Hourly Orders], _Win )
			VAR _First6 = CALCULATE ( [Hourly Orders], FILTER ( _Win, FactHourlyCampaignTraffic[Hours Since Launch] <= 5 ) )
			VAR _Peak = TOPN ( 1, ADDCOLUMNS ( VALUES ( FactHourlyCampaignTraffic[HourOfDayBDT] ), "@o", CALCULATE ( [Hourly Orders], _Win ) ), [@o], DESC )
			RETURN
			    IF (
			        ISBLANK ( _All ),
			        "Hourly 11.11 order curve",
			        "Launch night captures " & FORMAT ( DIVIDE ( _First6, _All ), "0%" ) & " of 54-hour orders in 6 hours (vs 11% if even), and demand re-peaks daily around "
			            & FORMAT ( MAXX ( _Peak, FactHourlyCampaignTraffic[HourOfDayBDT] ), "00" ) & ":00 – staff capacity to these peaks"
			    )
		displayFolder: 11. Dashboard Text
		lineageTag: 8a9c4115-92b6-4df9-b0a5-21af52a5ad4b

	measure 'Title Promotions' =
			VAR _P = FILTER ( ADDCOLUMNS ( VALUES ( DimPromotion[PromotionName] ), "@n", [Campaign Net Sales], "@m", [Campaign Contribution Margin %] ), NOT ISBLANK ( [@n] ) )
			VAR _Neg = COUNTROWS ( FILTER ( _P, [@m] < 0 ) )
			VAR _Tot = COUNTROWS ( _P )
			RETURN
			    IF (
			        _Tot = 0,
			        "11.11 promotion mechanics",
			        FORMAT ( _Neg, "0" ) & " of " & _Tot & " 11.11 promotions destroy margin – " & MAXX ( TOPN ( 1, _P, [@m], DESC ), DimPromotion[PromotionName] )
			            & " is the only clear value creator"
			    )
		displayFolder: 11. Dashboard Text
		lineageTag: fc7d14be-3b1a-4f20-9eb6-91cf73acb685

	measure 'Title Funnel' =
			VAR _S1 = DIVIDE ( [Product Views], [Sessions] )
			VAR _S2 = DIVIDE ( [Add-to-Cart Events], [Product Views] )
			VAR _S3 = DIVIDE ( [Checkout Starts], [Add-to-Cart Events] )
			VAR _S4 = DIVIDE ( [Attributed Orders], [Checkout Starts] )
			VAR _Min = MIN ( MIN ( _S1, _S2 ), MIN ( _S3, _S4 ) )
			VAR _Step = SWITCH ( _Min, _S1, "Session → Product View", _S2, "Product View → Add to Cart", _S3, "Cart → Checkout", "Checkout → Order" )
			RETURN
			    "Biggest funnel leak is " & _Step & " – only " & FORMAT ( _Min, "0%" ) & " progress; " & FORMAT ( [Session Conversion Rate %], "0.0%" ) & " of sessions convert"
		displayFolder: 11. Dashboard Text
		lineageTag: 88212cc7-9dbf-4276-acdb-536a070fc5e2

	measure 'Title Channel Efficiency' =
			VAR _T = FILTER ( ADDCOLUMNS ( VALUES ( DimChannel[ChannelName] ), "@c", [Customer Acquisition Cost (CAC)] ), [@c] > 0 )
			VAR _Lo = TOPN ( 1, _T, [@c], ASC )
			VAR _Hi = TOPN ( 1, _T, [@c], DESC )
			RETURN
			    IF (
			        ISEMPTY ( _T ),
			        "Channel efficiency",
			        "CAC ranges from ৳" & FORMAT ( MAXX ( _Lo, [@c] ), "#,0" ) & " (" & MAXX ( _Lo, DimChannel[ChannelName] ) & ") to ৳"
			            & FORMAT ( MAXX ( _Hi, [@c] ), "#,0" ) & " (" & MAXX ( _Hi, DimChannel[ChannelName] ) & ") at near-identical margins"
			    )
		displayFolder: 11. Dashboard Text
		lineageTag: 197ddcdf-6c57-41d4-aa17-b74ab2c28123

	measure 'Title SKU Matrix' =
			IF (
			    ISBLANK ( [Margin-Trap Campaign CM %] ),
			    "SKU profitability vs scale – bubbles below 0% destroy value",
			    "Margin-trap SKUs (red) sit at " & FORMAT ( CALCULATE ( [Contribution Margin %], DimProduct[IsMarginTrapSKU] = 1 ), "0.0%" )
			        & " margin overall but " & FORMAT ( [Margin-Trap Campaign CM %], "0.0%" ) & " in 11.11 – discount caps needed"
			)
		displayFolder: 11. Dashboard Text
		lineageTag: e3ca56ec-8951-4901-9789-e650e447fd48

	measure 'Title Division' =
			VAR _D = FILTER ( ADDCOLUMNS ( VALUES ( DimGeography[Division] ), "@s", [Net Merchandise Sales], "@o", [On-Time Delivery Rate %] ), NOT ISBLANK ( [@s] ) )
			VAR _Top = TOPN ( 1, _D, [@s], DESC )
			RETURN
			    MAXX ( _Top, DimGeography[Division] ) & " holds " & FORMAT ( DIVIDE ( MAXX ( _Top, [@s] ), [Net Merchandise Sales] ), "0%" )
			        & " of net sales but only " & FORMAT ( MAXX ( _Top, [@o] ), "0%" ) & " on-time delivery"
		displayFolder: 11. Dashboard Text
		lineageTag: 3b29f505-eb49-46bd-a0e0-b5f3c949f20f

	measure 'Title Payment Methods' =
			VAR _P = FILTER ( ADDCOLUMNS ( VALUES ( DimPaymentMethod[PaymentMethodName] ), "@f", [Campaign Payment Failure Rate %] ), NOT ISBLANK ( [@f] ) )
			VAR _W = TOPN ( 1, _P, [@f], DESC )
			RETURN
			    IF (
			        ISEMPTY ( _P ),
			        "Payment failure rate by method",
			        MAXX ( _W, DimPaymentMethod[PaymentMethodName] ) & " fails " & FORMAT ( MAXX ( _W, [@f] ), "0.0%" )
			            & " of attempts during 11.11 – gateway capacity is a revenue lever"
			    )
		displayFolder: 11. Dashboard Text
		lineageTag: 6e9662e3-6b50-4a3e-b103-bdf9723b47bc

	measure 'Title Ops Stress' =
			VAR _Late11 = CALCULATE ( [Late Delivery Rate %], DimCampaign[EventClassification] = "11.11 Main Event Window" )
			VAR _LateN = CALCULATE ( [Late Delivery Rate %], DimCampaign[EventClassification] = "Normal Trading" )
			RETURN
			    "Every operating KPI deteriorates in 11.11 – late deliveries rise from " & FORMAT ( _LateN, "0%" ) & " to " & FORMAT ( _Late11, "0%" )
		displayFolder: 11. Dashboard Text
		lineageTag: 4e5765dc-d00b-4238-9030-d186752842f7

	measure 'Title Cohort' =
			VAR _A = CALCULATE ( [Net Sales per Customer], DimCustomer[AcquiredDuring1111Flag] = 1, REMOVEFILTERS ( DimDate ) )
			VAR _B = CALCULATE ( [Net Sales per Customer], DimCustomer[AcquiredDuring1111Flag] = 0, REMOVEFILTERS ( DimDate ) )
			RETURN
			    "11.11-acquired customers repeat at " & FORMAT ( [11.11-Acquired Repeat Rate %], "0.0%" ) & " vs " & FORMAT ( [Normal-Acquired Repeat Rate %], "0.0%" )
			        & " and spend " & FORMAT ( 1 - DIVIDE ( _A, _B ), "0%" ) & " less per head (lifetime)"
		displayFolder: 11. Dashboard Text
		lineageTag: 43773641-c6bf-4af1-8378-aac2533fa494

	/// Contribution margin recovered if margin-trap SKUs earned the same 11.11 CM% as other SKUs.
	measure 'Upside Discount Caps' =
			VAR _MTNS = CALCULATE ( [Campaign Net Sales], DimProduct[IsMarginTrapSKU] = 1 )
			VAR _Gap = CALCULATE ( [Campaign Contribution Margin %], DimProduct[IsMarginTrapSKU] = 0 ) - [Margin-Trap Campaign CM %]
			RETURN MAX ( 0, _MTNS * _Gap )
		formatString: ৳#,0
		displayFolder: 12. Strategic Priorities
		lineageTag: 718ab2d4-0979-42cc-afc7-f7092c30854d

	/// Contribution margin lost on 11.11 promotions running below 0% CM (brought to breakeven).
	measure 'Upside Promotion Reset' = SUMX ( VALUES ( DimPromotion[PromotionName] ), VAR _CM = CALCULATE ( [Contribution Margin], DimCampaign[EventClassification] = "11.11 Main Event Window" ) RETURN IF ( _CM < 0, -_CM ) )
		formatString: ৳#,0
		displayFolder: 12. Strategic Priorities
		lineageTag: 33d374d5-a3b9-4116-8b5b-64b30234c8b3

	/// 11.11 GMV on cancelled orders if the 11.11 cancellation rate matched normal trading.
	measure 'Upside Payment Recovery' =
			VAR _CancGMV = CALCULATE ( [Gross Merchandise Value (GMV)], FactOrderLine[OrderStatus] = "Cancelled", DimCampaign[EventClassification] = "11.11 Main Event Window" )
			VAR _Excess = DIVIDE ( [Campaign Cancellation Rate %] - CALCULATE ( [Cancellation Rate %], DimCampaign[EventClassification] = "Normal Trading" ), [Campaign Cancellation Rate %] )
			RETURN MAX ( 0, _CancGMV * _Excess )
		formatString: ৳#,0
		displayFolder: 12. Strategic Priorities
		lineageTag: b138af81-cf53-40ea-8ab4-dd229909c4fe

	/// Extra attributed revenue if 20% of the lowest-ROAS channel's spend earned the highest-ROAS paid search/social level (conservative: uses Paid Search ROAS).
	measure 'Upside Budget Reallocation' =
			VAR _Social = CALCULATE ( [Advertising Spend], DimChannel[ChannelName] = "Paid Social (Meta/TikTok Ads)" )
			VAR _RS = CALCULATE ( [ROAS], DimChannel[ChannelName] = "Paid Social (Meta/TikTok Ads)" )
			VAR _RQ = CALCULATE ( [ROAS], DimChannel[ChannelName] = "Paid Search (Google/YouTube)" )
			RETURN MAX ( 0, 0.2 * _Social * ( _RQ - _RS ) )
		formatString: ৳#,0
		displayFolder: 12. Strategic Priorities
		lineageTag: 2e77fc72-ffd4-45d4-8d30-058b589feb31

	measure 'Rec 1 Evidence' =
			[Margin-Trap SKU Count] & " margin-trap SKUs run at " & FORMAT ( [Margin-Trap Campaign Discount %], "0.0%" ) & " discount in 11.11 and post "
			    & FORMAT ( [Margin-Trap Campaign CM %], "0.0%" ) & " contribution margin vs " & FORMAT ( CALCULATE ( [Campaign Contribution Margin %], DimProduct[IsMarginTrapSKU] = 0 ), "0.0%" )
			    & " for other SKUs. Set SKU-level discount ceilings and exclude them from sitewide vouchers."
		displayFolder: 12. Strategic Priorities
		lineageTag: 4650f1c2-ac13-4ada-86b4-4d6d02e410bf

	measure 'Rec 2 Evidence' =
			VAR _P = FILTER ( ADDCOLUMNS ( VALUES ( DimPromotion[PromotionName] ), "@n", [Campaign Net Sales], "@m", [Campaign Contribution Margin %] ), NOT ISBLANK ( [@n] ) )
			VAR _Neg = FILTER ( _P, [@m] < 0 )
			VAR _Best = TOPN ( 1, _P, [@m], DESC )
			RETURN
			    FORMAT ( COUNTROWS ( _Neg ), "0" ) & " mechanics (" & CONCATENATEX ( _Neg, SUBSTITUTE ( DimPromotion[PromotionName], "11.11 ", "" ), "; " ) & ") generate ৳"
			        & FORMAT ( SUMX ( _Neg, [@n] ) / 1e6, "0.0" ) & "M sales below breakeven. Re-weight funding toward " & SUBSTITUTE ( MAXX ( _Best, DimPromotion[PromotionName] ), "11.11 ", "" )
			        & " (" & FORMAT ( MAXX ( _Best, [@m] ), "0.0%" ) & " CM)."
		displayFolder: 12. Strategic Priorities
		lineageTag: 517e3c1a-1c6c-4d90-84e4-585c5db7b9af

	measure 'Rec 3 Evidence' =
			"CRM returns " & FORMAT ( CALCULATE ( [ROAS], DimChannel[ChannelName] = "SMS & Email CRM Broadcast" ), "0" ) & "x and Paid Search "
			    & FORMAT ( CALCULATE ( [ROAS], DimChannel[ChannelName] = "Paid Search (Google/YouTube)" ), "0" ) & "x vs Paid Social at "
			    & FORMAT ( CALCULATE ( [ROAS], DimChannel[ChannelName] = "Paid Social (Meta/TikTok Ads)" ), "0" ) & "x, which absorbs "
			    & FORMAT ( DIVIDE ( CALCULATE ( [Advertising Spend], DimChannel[ChannelName] = "Paid Social (Meta/TikTok Ads)" ), [Advertising Spend] ), "0%" )
			    & " of spend. Shift 20% of Paid Social into Search and CRM ahead of 11.11."
		displayFolder: 12. Strategic Priorities
		lineageTag: be53a27a-49d7-47ea-aaac-147baaaeafa1

	measure 'Rec 4 Evidence' =
			"During 11.11, payment failures hit " & FORMAT ( [Campaign Payment Failure Rate %], "0.0%" ) & ", cancellations " & FORMAT ( [Campaign Cancellation Rate %], "0.0%" )
			    & " and on-time delivery falls to " & FORMAT ( [Campaign On-Time Delivery Rate %], "0%" ) & " (vs "
			    & FORMAT ( CALCULATE ( [On-Time Delivery Rate %], DimCampaign[EventClassification] = "Normal Trading" ), "0%" )
			    & " normally). Pre-book wallet/gateway headroom and courier surge slots for launch night and the daily evening peaks."
		displayFolder: 12. Strategic Priorities
		lineageTag: 0ee6cfcb-ff59-487e-8396-460e50836a1d

	measure 'Rec 5 Evidence' =
			"11.11-acquired customers repeat at " & FORMAT ( [11.11-Acquired Repeat Rate %], "0%" ) & " vs " & FORMAT ( [Normal-Acquired Repeat Rate %], "0%" )
			    & " and are worth ৳" & FORMAT ( CALCULATE ( [Net Sales per Customer], DimCustomer[AcquiredDuring1111Flag] = 1, REMOVEFILTERS ( DimDate ) ) / 1e3, "0" ) & "K vs ৳"
			    & FORMAT ( CALCULATE ( [Net Sales per Customer], DimCustomer[AcquiredDuring1111Flag] = 0, REMOVEFILTERS ( DimDate ) ) / 1e3, "0" ) & "K over their lifetime. Launch a 60-day post-event CRM journey to convert deal-seekers."
		displayFolder: 12. Strategic Priorities
		lineageTag: 82396de7-e6a7-4382-afa7-8226d23d56f9

	measure 'Title Nov Curve' =
			VAR _R = [Post-Campaign Retention vs Baseline %]
			RETURN
			    IF (
			        ISBLANK ( _R ),
			        "Daily net sales, Nov 1–20, by year",
			        "Post-event daily sales run " & FORMAT ( ABS ( _R ), "0%" ) & IF ( _R < 0, " below", " above" )
			            & " the October baseline – part of the 11.11 spike is demand pulled forward, not created"
			    )
		displayFolder: 11. Dashboard Text
