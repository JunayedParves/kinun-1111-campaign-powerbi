	/// Hour index (0-53) within the 54-hour 11.11 window starting Nov 10 18:00 BDT. Blank outside the window.
	column 'Hours Since Launch' = IF ( FactHourlyCampaignTraffic[IsOfficial54HrWindow] = 1, DATEDIFF ( DATE ( YEAR ( FactHourlyCampaignTraffic[TimestampHourBDT] ), 11, 10 ) + TIME ( 18, 0, 0 ), FactHourlyCampaignTraffic[TimestampHourBDT], HOUR ) )
		formatString: 0
		lineageTag: 90bc1d01-d371-4f94-b78e-9b85b040a867
		summarizeBy: none

